// Minimal Windows version resource so the engine can read the editor's
// file version metadata at startup (Engine reads it via GetFileVersionInfo
// and throws "Failed to get file version size" if the resource is missing).
//
// Keep in sync with samples/windows/samples.rc when bumping versions.

#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x0L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fluxion"
            VALUE "FileDescription", "Fluxion editor"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "editor.rc"
            VALUE "LegalCopyright", "Public Domain"
            VALUE "OriginalFilename", "editor.exe"
            VALUE "ProductName", "Fluxion Editor"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
